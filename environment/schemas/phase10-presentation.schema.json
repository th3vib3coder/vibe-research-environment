{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase10.presentation.v1",
  "title": "Phase 10 Presentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "presentationId",
    "domainId",
    "title",
    "presentationUse",
    "sourcePageId",
    "sourcePageIds",
    "exportRecipeId",
    "templateId",
    "templateVersion",
    "sourcePageSha",
    "provenanceManifestSha",
    "edgeManifestSha",
    "renderedContentSha",
    "decisionUseAtRender",
    "epistemicBadge",
    "epistemicBadgeRequired",
    "renderedAt",
    "renderedBy",
    "presentationStatus",
    "stalenessPolicy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "phase10.presentation.v1"
    },
    "presentationId": {
      "type": "string",
      "pattern": "^PRES-.+$"
    },
    "domainId": {
      "type": "string",
      "pattern": "^KDOM-.+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "presentationUse": {
      "type": "string",
      "enum": [
        "morning-digest",
        "r2-verdict",
        "synthesis-conference",
        "synthesis-preprint",
        "query-decision",
        "query-audit",
        "hypothesis-discussion"
      ]
    },
    "sourcePageId": {
      "type": "string",
      "pattern": "^WIKI-.+$"
    },
    "sourcePageIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^WIKI-.+$"
      }
    },
    "exportRecipeId": {
      "type": "string",
      "pattern": "^EXPORT-.+$"
    },
    "templateId": {
      "type": "string",
      "pattern": "^MARP-.+$"
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePageSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenanceManifestSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "edgeManifestSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "renderedContentSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisionUseAtRender": {
      "type": "string",
      "enum": [
        "not-for-decision",
        "informational",
        "evidence-support",
        "decision-grade",
        "audit-grade"
      ]
    },
    "epistemicBadge": {
      "type": "string",
      "minLength": 1
    },
    "epistemicBadgeRequired": {
      "const": true
    },
    "renderedAt": {
      "type": "string",
      "format": "date-time"
    },
    "renderedBy": {
      "type": "string",
      "minLength": 1
    },
    "presentationStatus": {
      "type": "string",
      "enum": ["active", "archived"]
    },
    "freshnessOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "reason", "localReviewOnly"],
      "properties": {
        "requested": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "affectsDecisionUse": {
          "type": "boolean"
        },
        "localReviewOnly": {
          "const": true
        }
      }
    },
    "stalenessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSourceAgeDays"],
      "properties": {
        "maxSourceAgeDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
