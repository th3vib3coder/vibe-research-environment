{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase12.relay-review.v1",
  "title": "Phase 12 relay review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "reviewId",
    "reviewer",
    "reviewedArtifactRef",
    "mode",
    "verdict",
    "severity",
    "findings",
    "requiredActions",
    "residualRisk",
    "selfCertificationCheck",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "phase12.relay-review.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "reviewId": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewedArtifactRef": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "plan-review",
          "code-review",
          "hat3-review",
          "phase10-law13-review",
          "phase11-graph-review"
        ]
      }
    },
    "verdict": { "enum": ["ACCEPT", "REDIRECT", "BLOCK"] },
    "severity": { "enum": ["P0", "P1", "P2", "P3", "NONE"] },
    "findings": { "type": "array", "items": { "type": "object" } },
    "requiredActions": { "type": "array", "items": { "type": "string" } },
    "residualRisk": { "type": "array", "items": { "type": "string" } },
    "selfCertificationCheck": {
      "const": "reviewer-did-not-author-reviewed-artifact"
    },
    "extensionSchemaVersion": {
      "enum": [
        "phase12.phase10-law13-review-extension.v1",
        "phase12.phase11-graph-review-extension.v1"
      ]
    },
    "extensionRef": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
