{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase9.analysis-manifest.v1",
  "title": "Phase 9 Analysis Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "objectiveId",
    "experimentId",
    "analysisId",
    "script",
    "inputs",
    "outputs",
    "command",
    "budget",
    "safety",
    "taskKind",
    "expectedArtifacts",
    "humanApproval",
    "createdAt",
    "createdBy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "phase9.analysis-manifest.v1"
    },
    "objectiveId": {
      "type": "string",
      "pattern": "^OBJ-[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3}$"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^ANL-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "script": {
      "$ref": "#/definitions/scriptRef"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ioRef"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ioRef"
      }
    },
    "command": {
      "$ref": "#/definitions/commandRef"
    },
    "environment": {
      "$ref": "#/definitions/environmentRef"
    },
    "budget": {
      "$ref": "#/definitions/budgetRef"
    },
    "safety": {
      "$ref": "#/definitions/safetyRef"
    },
    "taskKind": {
      "const": "analysis-execution-run"
    },
    "expectedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/expectedArtifactRef"
      }
    },
    "humanApproval": {
      "$ref": "#/definitions/humanApprovalRef"
    },
    "experimentRegistration": {
      "$ref": "#/definitions/experimentRegistrationRef"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "scriptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "language"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "language": {
          "type": "string",
          "enum": [
            "python",
            "r",
            "bash",
            "notebook",
            "other"
          ]
        }
      }
    },
    "ioRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "commandRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "argv"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "python",
            "Rscript",
            "jupyter",
            "snakemake",
            "nextflow",
            "other"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreterKind",
        "interpreterId",
        "interpreterVersion",
        "resolver",
        "executableHint",
        "resolutionStatus",
        "resolutionReason",
        "dependencyLock",
        "dependencyPins",
        "environmentFiles",
        "knownSeams"
      ],
      "properties": {
        "interpreterKind": {
          "type": "string",
          "enum": [
            "python",
            "r",
            "notebook"
          ]
        },
        "interpreterId": {
          "type": "string",
          "minLength": 1
        },
        "interpreterVersion": {
          "type": "string",
          "minLength": 1
        },
        "resolver": {
          "type": "string",
          "enum": [
            "operator-managed-venv",
            "conda",
            "renv",
            "system",
            "other"
          ]
        },
        "executableHint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|[\\\\/])Users[\\\\/]).+$"
        },
        "resolutionStatus": {
          "type": "string",
          "enum": [
            "resolved",
            "blocked",
            "deferred"
          ]
        },
        "resolutionReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dependencyLock": {
          "$ref": "#/definitions/environmentFileRef"
        },
        "dependencyPins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/dependencyPinRef"
          }
        },
        "environmentFiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/environmentFileRef"
          }
        },
        "knownSeams": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/environmentSeamRef"
          }
        }
      }
    },
    "dependencyPinRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environmentFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "hashDeferredReason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "hashDeferredReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            },
            "required": [
              "sha256"
            ]
          },
          "then": {
            "properties": {
              "hashDeferredReason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "hashDeferredReason"
            ]
          }
        }
      ]
    },
    "environmentSeamRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "status",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PYTHON_3_14_NUMBA_PYNNDESCENT_UMAP",
            "OTHER"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "blocked",
            "deferred",
            "resolved"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budgetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRuntimeSeconds",
        "maxMemoryGb",
        "allowNetwork"
      ],
      "properties": {
        "maxRuntimeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxMemoryGb": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "allowNetwork": {
          "type": "boolean"
        }
      }
    },
    "safetyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destructive",
        "treeWideWrite",
        "externalCall"
      ],
      "properties": {
        "destructive": {
          "type": "boolean"
        },
        "treeWideWrite": {
          "type": "boolean"
        },
        "externalCall": {
          "type": "boolean"
        }
      }
    },
    "expectedArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "humanApprovalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "approvedBy",
        "approvedAt",
        "reason"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "experimentRegistrationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "registerInputPath"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "existing",
            "same-transaction-register"
          ]
        },
        "registerInputPath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "script": {
                "properties": {
                  "language": {
                    "enum": [
                      "python",
                      "r",
                      "notebook"
                    ]
                  }
                },
                "required": [
                  "language"
                ]
              }
            },
            "required": [
              "script"
            ]
          },
          {
            "properties": {
              "command": {
                "properties": {
                  "runner": {
                    "enum": [
                      "python",
                      "Rscript",
                      "jupyter"
                    ]
                  }
                },
                "required": [
                  "runner"
                ]
              }
            },
            "required": [
              "command"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "environment"
        ],
        "properties": {
          "budget": {
            "properties": {
              "allowNetwork": {
                "const": false
              }
            },
            "required": [
              "allowNetwork"
            ]
          },
          "safety": {
            "properties": {
              "externalCall": {
                "const": false
              }
            },
            "required": [
              "externalCall"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "script": {
            "properties": {
              "language": {
                "const": "python"
              }
            },
            "required": [
              "language"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "runner": {
                "const": "python"
              }
            },
            "required": [
              "runner"
            ]
          },
          "environment": {
            "properties": {
              "interpreterKind": {
                "const": "python"
              }
            },
            "required": [
              "interpreterKind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "script": {
            "properties": {
              "language": {
                "const": "r"
              }
            },
            "required": [
              "language"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "runner": {
                "const": "Rscript"
              }
            },
            "required": [
              "runner"
            ]
          },
          "environment": {
            "properties": {
              "interpreterKind": {
                "const": "r"
              }
            },
            "required": [
              "interpreterKind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "script": {
            "properties": {
              "language": {
                "const": "notebook"
              }
            },
            "required": [
              "language"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "runner": {
                "const": "jupyter"
              }
            },
            "required": [
              "runner"
            ]
          },
          "environment": {
            "properties": {
              "interpreterKind": {
                "const": "notebook"
              }
            },
            "required": [
              "interpreterKind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety": {
            "properties": {
              "destructive": {
                "const": true
              }
            },
            "required": [
              "destructive"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "humanApproval": {
            "properties": {
              "approved": {
                "const": true
              }
            },
            "required": [
              "approved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety": {
            "properties": {
              "treeWideWrite": {
                "const": true
              }
            },
            "required": [
              "treeWideWrite"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "humanApproval": {
            "properties": {
              "approved": {
                "const": true
              }
            },
            "required": [
              "approved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "humanApproval": {
            "properties": {
              "approved": {
                "const": true
              }
            },
            "required": [
              "approved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "humanApproval": {
            "properties": {
              "approvedBy": {
                "type": "string",
                "minLength": 1
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "experimentRegistration": {
            "properties": {
              "mode": {
                "const": "same-transaction-register"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "experimentRegistration": {
            "properties": {
              "registerInputPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
