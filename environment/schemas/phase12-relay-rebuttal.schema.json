{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase12.relay-rebuttal.v1",
  "title": "Phase 12 relay rebuttal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "rebuttalId",
    "author",
    "respondsToReviewId",
    "createdAt",
    "acceptedFindings",
    "rejectedFindings",
    "changesMade",
    "residualRisks",
    "operatorDecisionsRequired"
  ],
  "properties": {
    "schemaVersion": { "const": "phase12.relay-rebuttal.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "rebuttalId": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "respondsToReviewId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "acceptedFindings": { "type": "array", "items": { "type": "string" } },
    "rejectedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "evidenceRefs"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "changesMade": { "type": "array", "items": { "type": "string" } },
    "residualRisks": { "type": "array", "items": { "type": "string" } },
    "operatorDecisionsRequired": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
