{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase12.relay-candidate.v1",
  "title": "Phase 12 relay candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "artifactId",
    "artifactKind",
    "author",
    "createdAt",
    "artifactPath",
    "sourceRefs",
    "changedFiles",
    "claimBoundary",
    "validationPerformed",
    "knownLimits"
  ],
  "properties": {
    "schemaVersion": { "const": "phase12.relay-candidate.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactKind": {
      "enum": ["plan", "code-diff", "wiki-output", "graph-output", "closure-report"]
    },
    "author": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "artifactPath": { "$ref": "#/$defs/relativePath" },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "changedFiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "claimBoundary": {
      "enum": ["draft", "implementation-candidate", "validation-output"]
    },
    "validationPerformed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "knownLimits": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|/|\\\\)" }
    }
  }
}
