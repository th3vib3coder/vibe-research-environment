{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "phase14.shard-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scriptName",
    "pass",
    "testExitCode",
    "elapsedSeconds",
    "budgetSeconds",
    "withinBudget",
    "timestamp"
  ],
  "properties": {
    "schemaVersion": {
      "const": "phase14.shard-evidence.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "scriptName": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "boolean"
    },
    "testExitCode": {
      "type": "integer",
      "minimum": 0
    },
    "elapsedSeconds": {
      "type": "number",
      "minimum": 0
    },
    "budgetSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "withinBudget": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
